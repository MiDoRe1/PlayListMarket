<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_create_new_playlist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="24dp"
        style="@style/CommonStyleForButtonOnSearchScreen"
        app:cornerRadius="54dp"
        android:backgroundTint="?attr/colorOnPrimary"
        android:fontFamily="@font/ys_display_medium"
        android:textColor="?attr/colorPrimary"
        android:layout_gravity="center"
        android:gravity="center"
        android:textAllCaps="false"
        android:text="@string/new_playlist" />

    <LinearLayout
        android:id="@+id/linear_layout_empty_list_placeholder"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/button_create_new_playlist"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        >

            <ImageView
                android:paddingTop="46dp"
                android:paddingBottom="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/img_empty_result" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_playlists"
            style="@style/CommonTextStyle"/>


    </LinearLayout>






</androidx.constraintlayout.widget.ConstraintLayout>