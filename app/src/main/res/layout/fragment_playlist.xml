<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/yp_gray_light">

    <View android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#70000000"
        android:visibility="gone"/>

    <Toolbar
        android:id="@+id/toolbar_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/ToolbarStyle"
        android:navigationIcon="@drawable/ic_arrow_back_black"
        />

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar_header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="240dp">
            <ImageView
                android:id="@+id/imageview_playlist_cover"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/textview_playlist_name"
                app:layout_constrainedHeight="true"
                android:scaleType="centerCrop"
                android:src="@drawable/img_track_placeholder"
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_constraintVertical_bias="0">
            </ImageView>

            <TextView
                android:id="@+id/textview_playlist_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ys_display_bold"
                android:text="Name_song"
                android:textColor="@color/yp_black"
                android:textFontWeight="400"
                android:textSize="24sp"
                android:singleLine="true"
                android:layout_marginTop="24dp"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintTop_toBottomOf="@id/imageview_playlist_cover"
                app:layout_constraintBottom_toTopOf="@id/textview_playlist_description"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:maxLines="1"
                android:ellipsize="end"
                />

            <TextView
                android:id="@+id/textview_playlist_description"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ys_display_regular"
                android:text="description_song"
                android:textColor="@color/yp_black"
                android:maxLines="2"
                android:ellipsize="end"
                android:textFontWeight="400"
                android:textSize="18sp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginVertical="8dp"
                app:layout_constraintTop_toBottomOf="@id/textview_playlist_name"
                app:layout_constraintBottom_toTopOf="@id/textview_playlist_total_time"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>


                <TextView
                    android:id="@+id/textview_playlist_total_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ys_display_regular"
                    android:text="300 минут"
                    android:textColor="@color/yp_black"
                    android:textSize="18sp"
                    app:layout_constraintTop_toBottomOf="@id/textview_playlist_description"
                    app:layout_constraintBottom_toTopOf="@id/button_share_playlist"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/img_dot"
                    android:layout_marginStart="16dp"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintHorizontal_bias="0.0"
                    />

                <ImageView
                    android:id="@+id/img_dot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_dot"
                    app:tint="@color/yp_black"
                    app:layout_constraintTop_toTopOf="@id/textview_playlist_total_time"
                    app:layout_constraintBottom_toBottomOf="@id/textview_playlist_total_time"
                    app:layout_constraintStart_toEndOf="@id/textview_playlist_total_time"
                    app:layout_constraintEnd_toStartOf="@id/textview_playlist_total_tracks"
                    />

                <TextView
                    android:id="@+id/textview_playlist_total_tracks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ys_display_regular"
                    android:text="98 треков"
                    android:textColor="@color/yp_black"
                    android:textSize="18sp"
                    app:layout_constraintTop_toTopOf="@id/textview_playlist_total_time"
                    app:layout_constraintBottom_toBottomOf="@id/textview_playlist_total_time"
                    app:layout_constraintStart_toEndOf="@id/img_dot"
                    app:layout_constraintEnd_toEndOf="parent"
                    />

            <ImageView
                android:id="@+id/button_share_playlist"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_share"
                app:tint="@color/yp_black"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/textview_playlist_total_time"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/button_playlist_setting"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintHorizontal_bias="0.0"
                android:layout_marginStart="16dp"
                />

            <ImageView
                android:id="@+id/button_playlist_setting"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:layout_constraintTop_toTopOf="@id/button_share_playlist"
                app:layout_constraintBottom_toBottomOf="@id/button_share_playlist"
                app:layout_constraintStart_toEndOf="@id/button_share_playlist"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginStart="16dp"
                android:src="@drawable/ic_3_dot"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/bottom_sheet_tracks_in_playlist"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/shape_bottomsheet"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="16dp"
            app:behavior_hideable="false"
            app:behavior_peekHeight="230dp"
            app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
            >


            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/shape_rounded_pip"
                android:backgroundTint="@color/playlist_bottom_sheet_pip"/>


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerview_tracks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/track_item"
                />


        </LinearLayout>


        <LinearLayout
            android:id="@+id/bottom_sheet_playlist_setting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_bottomsheet"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="16dp"
            app:behavior_hideable="true"
            app:behavior_peekHeight="auto"
            app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
            app:behavior_skipCollapsed="true"
            >


            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/shape_rounded_pip"
                android:backgroundTint="@color/playlist_bottom_sheet_pip"/>


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerview_playlist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:listitem="@layout/playlist_item_horizontal"
                tools:itemCount="1"
                android:layout_marginBottom="8dp"
                android:overScrollMode="never"/>

            <TextView
                android:id="@+id/button_setting_share"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/share"
                style="@style/settings_button_on_playlist"
                />
            <TextView
                android:id="@+id/button_edit_playlist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/edit_playlist"
                style="@style/settings_button_on_playlist"
                />
            <TextView
                android:id="@+id/button_delete_playlist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/delete_playlist"
                style="@style/settings_button_on_playlist"
                />




        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</androidx.constraintlayout.widget.ConstraintLayout>