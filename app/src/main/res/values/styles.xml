<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="CommonTitleTextForToolbarStyle">
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textFontWeight">500</item>
        <item name="fontFamily">@font/ys_display_medium</item>
    </style>

    <style name="CommonTextStyle" parent="CommonTitleTextForToolbarStyle">
        <item name="android:textFontWeight">400</item>
        <item name="android:textSize">19sp</item>
    </style>

    <style name="TextStileTrackDescriptionTitlesOnPlayMusic" parent="CommonTextStyle">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/yp_gray</item>
        <item name="android:layout_marginTop">17dp</item>
    </style>

    <style name="TextStileTrackDescriptionValuesOnPlayMusic" parent="CommonTextStyle">
        <item name="android:textSize">13sp</item>
    </style>


    <style name="TextEditorStyle" parent="Widget.MaterialComponents.TextInputEditText.FilledBox">
        <item name="android:paddingStart">0dp</item>
    </style>

    <style name="MakeLpaylistTextEditorTextStyle">
        <item name="fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
    </style>

    <style name="ToolbarStyle">
        <item name="titleTextAppearance">@style/CommonTitleTextForToolbarStyle</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="elevation">0dp</item>
        <item name="android:layout_marginBottom">24dp</item>
    </style>

    <style name="CommonTextStyleForButton">
        <item name="android:textSize">22sp</item>
        <item name="android:textFontWeight">500</item>
        <item name="fontFamily">@font/ys_display_medium</item>
        <item name="android:textColor">@color/yp_black</item>
    </style>

    <style name="CommonStyleForButtonOnSearchScreen">
        android:backgroundTint="?attr/colorOnPrimary"
        android:fontFamily="@font/ys_display_medium"
        android:textColor="?attr/colorPrimary"
        android:textSize="14sp"
        android:textFontWeight="500"
        android:textAllCaps="false"
    </style>

    <style name="ButtonStyle" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:backgroundTint">@color/yp_white</item>
        <item name="android:textAppearance">@style/CommonTextStyleForButton</item>
        <item name="elevation">0dp</item>
        <item name="android:textColor">@color/yp_black</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="iconTint">@color/yp_black</item>
        <item name="android:layout_marginHorizontal">@dimen/default_main_layout_padding_horizontal</item>
    </style>

    <style name="SettingMenuItemStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="fontFamily">@font/ys_display_regular</item>
        <item name="fontWeight">400</item>
    </style>
    
    <style name="MediaLibraryTabLayoutTextStyle" parent="TextAppearance.Design.Tab">
        <item name="android:textAllCaps">false</item>
        <item name="tabTextColor">@color/color_on_primary_for_app</item>
        <item name="tabIndicatorColor">@color/color_on_primary_for_app</item>
        <item name="textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
    </style>
    
    <style name="BottomNavigationViewText" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textSize">12sp</item>
        <item name="fontFamily">@font/ys_display_regular</item>
    </style>


    <style name="MyCustomAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:colorBackground">#FFFFFF</item>
        <item name="android:textColorPrimary">#212121</item>
        <item name="colorPrimary">?attr/colorOnPrimary</item>
    </style>

    <style name="RoundedImageViewShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="settings_button_on_playlist">
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:textColor">@color/track_name_on_search_screen</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingVertical">21dp</item>
        <item name="android:textAllCaps">false</item>
    </style>






</resources>