<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

        <ImageView
                android:id="@+id/imageview_playlist_cover"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_marginEnd="8dp"
                android:layout_marginVertical="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/text_barrier"
                android:src="@drawable/img"
                android:scaleType="centerCrop" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/text_barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="end"
            app:constraint_referenced_ids="imageview_playlist_cover" />

            <TextView
                android:id="@+id/textview_playlist_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/textview_playlist_count_tracks"
                app:layout_constraintStart_toEndOf="@id/text_barrier"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="16sp"
                android:fontFamily="@font/ys_display_regular"
                android:textColor="@color/track_name_on_search_screen"
                android:text="My Track"
                />


    <TextView
        android:id="@+id/textview_playlist_count_tracks"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/ys_display_regular"
        android:maxLines="1"
        android:text="9 треков"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/text_barrier"
        app:layout_constraintTop_toBottomOf="@id/textview_playlist_name"
        android:textColor="@color/track_group_and_time_on_search_screen"/>


</androidx.constraintlayout.widget.ConstraintLayout>