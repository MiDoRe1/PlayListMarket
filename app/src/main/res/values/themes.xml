<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.PlayListMarket" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary_color_for_app</item>
        <item name="colorPrimaryVariant">@color/primary_variant_color_for_app</item>
        <item name="colorOnPrimary">@color/color_on_primary_for_app</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/secondary_color_for_app</item>
        <item name="colorSecondaryVariant">@color/secondary_variant_color_for_app</item>
        <item name="colorOnSecondary">@color/color_on_secondary_for_app</item>
