<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="CommonTitleTextForToolbarStyle">
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textFontWeight">500</item>
        <item name="fontFamily">@font/ys_display_medium</item>
    </style>
    <style name="ToolbarStyle" >
        <item name="titleTextAppearance">@style/CommonTitleTextForToolbarStyle</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="elevation">0dp</item>
        <item name="android:layout_marginBottom">24dp</item>
    </style>
    <style name="CommonTextStyleForButton">
        <item name="android:textSize">22sp</item>
        <item name="android:textFontWeight">500</item>
        <item name="fontFamily">@font/ys_display_medium</item>
        <item name="android:textColor">@color/yp_black</item>
    </style>
    <style name="ButtonStyle" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:backgroundTint">@color/yp_white</item>
        <item name="android:textAppearance">@style/CommonTextStyleForButton</item>
        <item name="elevation">0dp</item>
        <item name="android:textColor">@color/yp_black</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="iconTint">@color/yp_black</item>
        <item name="android:layout_marginHorizontal">@dimen/default_main_layout_padding_horizontal</item>
    </style>
    <style name="SettingMenuItemStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="fontFamily">@font/ys_display_regular</item>
        <item name="fontWeight">400</item>
    </style>
</resources>